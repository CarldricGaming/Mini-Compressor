    </Target>
    <Target Name="Launcher:Clean">
        <MSBuild Projects="Launcher\Launcher.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Launcher:Make">
        <MSBuild Projects="Launcher\Launcher.dproj" Targets="Make"/>
    </Target>
    <Target Name="Cmd_MiniCompressor">
        <MSBuild Projects="MC_CMD\Cmd_MiniCompressor.dproj"/>
    </Target>
    <Target Name="Cmd_MiniCompressor:Clean">
        <MSBuild Projects="MC_CMD\Cmd_MiniCompressor.dproj" Targets="Clean"/>
